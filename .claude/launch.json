{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/forwardstate",
      "runtimeArgs": [
        "serve",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/node_modules/vite/bin/vite.js",
        "web",
        "--port",
        "5173",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    }
  ]
}
