    FC["4 · forecasting/<br/>block bootstrap<br/>3 scenarios × 3 horizons"]
    PF["5 · portfolio/ + risk/<br/>CVaR · drawdown<br/>candidates · optimizer"]
    AL["6 · alerts/<br/>rules · lifecycle · replay"]
    IND["industries/financials<br/>sector plug-in"]
  end

  subgraph API["FastAPI · api/"]
    R["/api routes<br/>no trading endpoints"]
    RR[("run registry<br/>hashes · reproduce")]
  end

  UI["React UI · web/<br/>Research · Portfolio<br/>Events & alerts · Settings<br/>Run provenance"]
  U(["Investor decides.<br/>ForwardState never trades."])

