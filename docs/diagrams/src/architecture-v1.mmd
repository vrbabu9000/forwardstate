%% ForwardState architecture v1 (Phase 1 MVP). Render: npx -y @mermaid-js/mermaid-cli@11.4.2 -i <this> -o <png|pdf>
flowchart LR
  subgraph SRC["Open data sources"]
    Y["Yahoo Finance<br/>prices · splits/dividends<br/>earnings · analyst actions"]
