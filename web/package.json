    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "16.0.0",
